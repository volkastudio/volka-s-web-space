# ─── Supabase (client + server) ──────────────────────────────────────────────
# Your Supabase project URL  (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=
SUPABASE_URL=

# Anon / publishable key  (safe to expose to browsers)
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Service-role key  — SERVER ONLY, never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=

# ─── SMTP — Hostinger Business Email ──────────────────────────────────────────
# Host:   smtp.hostinger.com
# Port:   465 (SSL/TLS — recommended)  or  587 (STARTTLS)
# Secure: true for port 465, false for 587
# User:   your full Hostinger email address, e.g. hello@volkastudio.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@volkastudio.com
SMTP_PASS=
MAIL_FROM="Volka Studio <hello@volkastudio.com>"
# Comma-separated list of studio inboxes that receive each new brief
MAIL_NOTIFY_TO=hello@volkastudio.com
# Shown to visitors in the auto-reply for urgent matters
CONTACT_EMAIL=hello@volkastudio.com
# Digits only, with country code, e.g. 22990000000. Leave empty to hide WhatsApp.
WHATSAPP_NUMBER=

# ─── Site ─────────────────────────────────────────────────────────────────────
SITE_URL=https://volkastudio.com

# ─── Security (Phase 2) ───────────────────────────────────────────────────────
# Random secret for IP-hash rate limiting — generate with: openssl rand -hex 32
SECRET_SALT=
