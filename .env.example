# ─── Supabase (client + server) ──────────────────────────────────────────────
# Your Supabase project URL  (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=
SUPABASE_URL=

# Anon / publishable key  (safe to expose to browsers)
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Service-role key  — SERVER ONLY, never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=

# ─── SMTP (Phase 2) ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Volka Studio <hello@yourdomain.com>"
MAIL_NOTIFY_TO=you@yourdomain.com

# ─── Site ─────────────────────────────────────────────────────────────────────
SITE_URL=https://yourdomain.com

# ─── Security (Phase 2) ───────────────────────────────────────────────────────
# Random secret for IP-hash rate limiting — generate with: openssl rand -hex 32
SECRET_SALT=
